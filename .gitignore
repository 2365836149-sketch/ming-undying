# 只发布能玩的游戏：先全部忽略，再逐项放行。
# 生图脚本（generate_*.mjs、archive/、.history/）里有私钥，绝不能放行。
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/*.js
!/style.css
!/pixel.css

!/fonts/
/fonts/*
!/fonts/*.woff2
!/fonts/*.txt

!/assets/
/assets/*
!/assets/items/
/assets/items/*
!/assets/items/*.png
!/assets/portraits/
/assets/portraits/*
!/assets/portraits/*.png
!/assets/locations/
/assets/locations/*
!/assets/locations/*.jpg
!/assets/map/
/assets/map/*
!/assets/map/*.svg
!/assets/sfx/
/assets/sfx/*
!/assets/sfx/*.mp3
!/assets/music/
/assets/music/*
!/assets/music/*.m4a

.DS_Store
